# Copy to .env.local (gitignored) and fill in values.

# Daily cron (07:00 / 13:00 / 20:00 Beijing): default GuangYa Skill cloud add (not PikPak)
# DOWNLOAD_PROVIDER=guangya
# GUANGYAPAN_DRIVE_LOGIN_MODE=device
# Single folder name or remote id for all daily submits (recommended on cron VM):
# GUANGYA_CLOUD_PARENT=My Pack
# Region folders when GUANGYA_CLOUD_PARENT unset (default both My Pack):
# GUANGYAPAN_FOLDER_JAV=My Pack
# GUANGYAPAN_FOLDER_DOMESTIC=My Pack
# Dry-run plan only: GUANGYA_CLOUD_DRY_RUN=1  or  daily_run.py --guangya-dry-run
# Re-enable PikPak for daily: DAILY_USE_PIKPAK=1  or  daily_run.py --use-pikpak
# Legacy guangyaclient v1 folder id (guangya_download.py only):
# GUANGYA_PARENT_ID=
# PikPak→GuangYa bridge (guangya_cloud_submit.py) still defaults to downloads:
# GUANGYAPAN_FOLDER_DOWNLOADS=downloads

# PikPak personal access token (optional if using pikpak_auth.json)
PIKPAK_TOKEN=

# Feishu / Lark app credentials (forum scanner scripts)
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# Target chat: chat_id (group) or open_id / user_id (DM)
# Add the app bot to the group before sending.
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id

# Multi-source RSS aggregator — app bot (preferred) or webhook
# App mode: FEISHU_APP_ID + FEISHU_APP_SECRET + FEISHU_RECEIVE_ID
# Webhook mode: FEISHU_WEBHOOK_URL (+ optional FEISHU_WEBHOOK_SECRET)
# FEISHU_AUTH_MODE=app          # force app or webhook when both are set
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# FEISHU_CHAT_ID=                # alias for FEISHU_RECEIVE_ID
# RSS_SOURCES_PATH=scripts/rss_sources.json
# RSS_ENABLED_CATEGORIES=tech_cn,tech_en,finance_cn,finance_intl,ai,insights
# RSS_MAX_ITEMS=50
# RSS_MAX_ITEMS_PER_CATEGORY=7
# RSS_LOOKBACK_DAYS=2
# RSS_UPDATE_DIR=update
# RSS translation (foreign titles/summaries → 中文 before Feishu + markdown)
# Uses deep-translator (Google Translate), same stack as TITLE_TRANSLATE on main.
# TITLE_TRANSLATE=1
# RSS_TRANSLATE=1
# RSS_TRANSLATE_BATCH_SIZE=10
# RSS_TRANSLATE_CHINESE_THRESHOLD=0.35
# Legacy single-feed override (skips JSON catalog):
# CNBETA_RSS_FEEDS=https://rss.cnbeta.com.tw
