# Copy to .env.local (gitignored) and fill in values.

# PikPak personal access token (optional if using pikpak_auth.json)
PIKPAK_TOKEN=

# Feishu / Lark app credentials
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# Target chat: chat_id (group) or open_id / user_id (DM)
# Add the app bot to the group before sending.
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
